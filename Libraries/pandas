#-------------------update-------------------
import pandas as pd
data = {
    "Name": ["Ali", "Sara", "Ahmed"],
    "Age": [20, 21, 19],
    "Marks": [85, 90, 78]
}
df = pd.DataFrame(data)
print(df)
df.loc[1, "Marks"] = 95        #update marks
print(df)

df.loc[df["Marks"] < 80, "Marks"] = 80       #condition basis------
print(df)


#-------------json, csv files , excel files====import export in pandas---------------
import pandas as pd
data = {
    "Name": ["sonia", "Saim", "Ahmerrr"],
    "Age": [20, 21, 19],
    "Marks": [85, 90, 78]
}
df = pd.DataFrame(data)
#-------------------automatically create ho jyn gi---------------------------
df.to_csv("students.csv", index=False)          #export to csv
df.to_excel("students.xlsx", index=False)            #excel
df.to_json("students.json", orient="records", indent=4)          # json

