class employes:
    def __init__(self,name,post,salary):
        self.name= name
        self.post = post
        self.__salary = salary
    def get_salary(self):
        return self.__salary
    def set_salary(self,salary):
         self.__salary= salary
    def display_data(self):
        print(f"name of employee is : {self.name}")
        print(f"post of employee is : {self.post}")
        print(f"salry of employee is : {self.__salary}")
emp=employes("Ali","manager","50,000")
emp.display_data()
emp.get_salary()
emp.set_salary(70000)
#-------------inheritance---------------
class animals():
    def sound(self,sound):
        self.sound = sound
        print(f" sound of animal is :{self.sound}")
class cat(animals):  #inherit animal class 
    def features(self,color,size):
        self.color= color
        self.size= size
    def display(self):
        print(f"color of cat is :{self.color}")
        print(f"size of cat is :{self.size}")
cat =cat()
cat.features("white","small")
cat.sound("meow , meow")
cat.display()
