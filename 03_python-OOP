class Calculator:          #overloading
    def add(self, a, b=0, c=0):
        return a + b + c
calc = Calculator()
print(calc.add(5))
print(calc.add(5, 10))
print(calc.add(5, 10, 15))
#-----------using args*-----------------
class Calculator:
    def add(self, *numbers):
        return sum(numbers)
calc = Calculator()
print(calc.add(5, 10))
print(calc.add(5, 10, 15))
print(calc.add(1, 2, 3, 4, 5))
