# -------------using context manager-----------(with),(open),(temp file),(zip file),(pathlib)
#with open---file automatically close ho jati hai -------------------------------

with open("data.text", "r") as file:   #with
    print(file.read())

with open("data.text", "w") as file:   #open
    file.write("new lineeeeeeeeee is added")


#temporary file------
import tempfile
with tempfile.TemporaryFile(mode="w+") as file:
    file.write("Temporary data")
    file.seek(0)  #go to line 1 we wanna read
    print(file.read())


